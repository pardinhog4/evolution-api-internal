# ── Variáveis do serviço no Railway ─────────────────────────────────────────────
# (o resto da configuração já está no Dockerfile)

# Chave global: só o operador usa. Cria e apaga instâncias. Nunca vai para uma plataforma.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTHENTICATION_API_KEY=

# Endereço público do serviço.
SERVER_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}

# Postgres e Redis do mesmo projeto (troque Postgres/Redis pelo nome dos serviços).
DATABASE_CONNECTION_URI=${{Postgres.DATABASE_URL}}?schema=evolution_api
CACHE_REDIS_URI=${{Redis.REDIS_URL}}/6

# ── Só na sua máquina, para o script scripts/empresa.mjs (arquivo .env, fora do git) ──
EVOLUTION_URL=https://SEU-DOMINIO.up.railway.app
EVOLUTION_ADMIN_KEY=
